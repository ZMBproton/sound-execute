QWidget {
    background-color: #101117;
    color: #E0E0E5;
    font-family: &quot;JetBrains Mono&quot;;

}


QLabel {
    background-color: transparent;
    color: #9295A6;
}

QPushButton, QToolButton {
    background-color: #1B1D28;
    color: #B5C8F7;
    border: 1px solid #303445;
    border-radius: 6px;
    padding: 7px 12px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #292D3E;
    border-color: #B5C8F7;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #343B50;
}

QPushButton:checked, QToolButton:checked {
    background-color: #303B32;
    color: #C5E2B7;
    border-color: #C5E2B7;
}

QPushButton:disabled {
    background-color: #161822;
    color: #555969;
    border-color: #252835;
}


QListWidget, QTreeWidget, QTableWidget {
    background-color: #161822;
    alternate-background-color: #1B1D28;
    border: 1px solid #303445;
    border-radius: 8px;
    padding: 5px;
    outline: none;
    selection-background-color: #2A3145;
    selection-color: #B5C8F7;
}


QListWidget {
    background-color: #171A24;
    color: #DCE2F0;
    border: 1px solid #303749;
    border-radius: 6px;
    padding: 5px;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    margin: 1px 0;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #292F40;
}

QListWidget::item:selected {
    background-color: #344766;
    color: #FFFFFF;
}


QLineEdit {
    background-color: #1B1D28;
    color: #E0E0E5;
    border: 1px solid #303445;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #B5C8F7;
    selection-color: #101117;
}

QLineEdit:focus {
    border-color: #B5C8F7;
}


QSlider::groove:horizontal {
    background-color: #303445;
    height: 5px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #B5C8F7;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background-color: #303445;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #B5C8F7;
    width: 12px;
    margin: -4px 0px;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background-color: #E0E0E5;
}


QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1B1D28;
    color: #B5C8F7;
    border: 1px solid #303445;
    border-radius: 5px;
    padding: 6px;
}

QComboBox:hover {
    border-color: #B5C8F7;
}

QComboBox QAbstractItemView {
    background-color: #1B1D28;
    color: #E0E0E5;
    selection-background-color: #2A3145;
    selection-color: #B5C8F7;
}


QScrollBar:vertical {
    background-color: #161822;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #44495C;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9295A6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: #161822;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #44495C;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


QMenuBar {
    background-color: #101117;
    color: #B5C8F7;
    border-bottom: 1px solid #303445;
}

QMenuBar::item {
    padding: 7px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #292D3E;
}


QMenu {
    background-color: #1B1D28;
    color: #E0E0E5;
    border: 1px solid #303445;
    padding: 5px;
}

QMenu::item {
    padding: 7px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2A3145;
    color: #B5C8F7;
}


QToolBar {
    background-color: #101117;
    border: none;
    spacing: 6px;
    padding: 4px;
}


QStatusBar {
    background-color: #101117;
    color: #C5E2B7;
    border-top: 1px solid #303445;
    font-size: 9pt;
}

QToolTip {
    background-color: #292D3E;
    color: #E0E0E5;
    border: 1px solid #44495C;
    padding: 5px;
}

QSplitter::handle {
    background-color: #303445;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}</string>
